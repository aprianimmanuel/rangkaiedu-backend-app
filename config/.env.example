# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rangkaiedu_dev
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Email Provider Configuration
# Primary SMTP Provider (backward compatibility)
EMAIL_PROVIDER_0_TYPE=smtp
EMAIL_PROVIDER_0_NAME=primary-smtp
EMAIL_PROVIDER_0_ENABLED=true
EMAIL_PROVIDER_0_PRIORITY=0
EMAIL_PROVIDER_0_SETTINGS_HOST=smtp.gmail.com
EMAIL_PROVIDER_0_SETTINGS_PORT=587
EMAIL_PROVIDER_0_SETTINGS_USERNAME=your_email@gmail.com
EMAIL_PROVIDER_0_SETTINGS_PASSWORD=your_app_password
EMAIL_PROVIDER_0_SETTINGS_FROM_EMAIL=your_email@gmail.com
EMAIL_PROVIDER_0_SETTINGS_FROM_NAME=Rangkai Edu
EMAIL_PROVIDER_0_SETTINGS_USE_TLS=true
EMAIL_PROVIDER_0_SETTINGS_USE_STARTTLS=true

# Alternative SendGrid Provider
EMAIL_PROVIDER_1_TYPE=sendgrid
EMAIL_PROVIDER_1_NAME=sendgrid-fallback
EMAIL_PROVIDER_1_ENABLED=false
EMAIL_PROVIDER_1_PRIORITY=1
EMAIL_PROVIDER_1_SETTINGS_API_KEY=your_sendgrid_api_key
EMAIL_PROVIDER_1_SETTINGS_FROM_EMAIL=noreply@yourdomain.com
EMAIL_PROVIDER_1_SETTINGS_FROM_NAME=Rangkai Edu

# Alternative Gmail OAuth2 Provider
EMAIL_PROVIDER_2_TYPE=gmail
EMAIL_PROVIDER_2_NAME=gmail-oauth2
EMAIL_PROVIDER_2_ENABLED=false
EMAIL_PROVIDER_2_PRIORITY=2
EMAIL_PROVIDER_2_SETTINGS_CLIENT_ID=your_google_client_id
EMAIL_PROVIDER_2_SETTINGS_CLIENT_SECRET=your_google_client_secret
EMAIL_PROVIDER_2_SETTINGS_REFRESH_TOKEN=your_google_refresh_token
EMAIL_PROVIDER_2_SETTINGS_ACCESS_TOKEN=your_google_access_token
EMAIL_PROVIDER_2_SETTINGS_FROM_EMAIL=your_email@yourdomain.com
EMAIL_PROVIDER_2_SETTINGS_FROM_NAME=Rangkai Edu

# SMS Provider Configuration
# Primary Twilio Provider (backward compatibility)
SMS_PROVIDER_0_TYPE=twilio
SMS_PROVIDER_0_NAME=primary-twilio
SMS_PROVIDER_0_ENABLED=true
SMS_PROVIDER_0_PRIORITY=0
SMS_PROVIDER_0_SETTINGS_ACCOUNT_SID=your_twilio_account_sid
SMS_PROVIDER_0_SETTINGS_AUTH_TOKEN=your_twilio_auth_token
SMS_PROVIDER_0_SETTINGS_FROM_NUMBER=+1234567890

# Alternative SNS Provider
SMS_PROVIDER_1_TYPE=sns
SMS_PROVIDER_1_NAME=sns-fallback
SMS_PROVIDER_1_ENABLED=false
SMS_PROVIDER_1_PRIORITY=1
SMS_PROVIDER_1_SETTINGS_ACCESS_KEY_ID=your_aws_access_key_id
SMS_PROVIDER_1_SETTINGS_SECRET_ACCESS_KEY=your_aws_secret_access_key
SMS_PROVIDER_1_SETTINGS_REGION=us-east-1
SMS_PROVIDER_1_SETTINGS_FROM_NUMBER=+1234567890

# Legacy SMTP Configuration (for backward compatibility)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Legacy Twilio Configuration (for backward compatibility)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIOSENDER_PHONE=+1234567890

# Alibaba Cloud OSS Configuration for Materials
OSS_BUCKET_NAME=your-oss-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_REGION=ap-southeast-1
OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
STORAGE_PROVIDER=local

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# GCS Configuration (deprecated)
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_SERVICE_ACCOUNT_KEY_PATH=path/to/service-account-key.json
GCS_PROJECT_ID=your-gcs-project-id

# HTTPS Configuration
HTTPS_ENABLED=false
HTTPS_PORT=8443
HTTP_PORT=8080

# Certificate Management
HTTPS_CERTIFICATE_TYPE=file
HTTPS_CERTIFICATE_FILE_CERT_FILE=./certs/server.crt
HTTPS_CERTIFICATE_FILE_KEY_FILE=./certs/server.key
HTTPS_CERTIFICATE_FILE_CA_FILE=

# Let's Encrypt Configuration
HTTPS_CERTIFICATE_LETSENCRYPT_EMAIL=admin@example.com
HTTPS_CERTIFICATE_LETSENCRYPT_DOMAINS=example.com,www.example.com
HTTPS_CERTIFICATE_LETSENCRYPT_CACHE_DIR=/var/cache/letsencrypt

# TLS Configuration
HTTPS_TLS_MIN_VERSION=TLS12
HTTPS_TLS_CIPHER_SUITES=TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
HTTPS_TLS_PREFER_SERVER_CIPHER_SUITES=true

# HSTS Configuration
HTTPS_HSTS_ENABLED=true
HTTPS_HSTS_MAX_AGE=31536000
HTTPS_HSTS_INCLUDE_SUBDOMAINS=true
HTTPS_HSTS_PRELOAD=false

# Redirect Configuration
HTTPS_REDIRECT_ENABLED=true
HTTPS_REDIRECT_STATUS_CODE=301
HTTPS_REDIRECT_PERMANENT=true